    "12": "Strive", "15": "Harvest", "17": "Fury", "30": "Momentum",
    "32": "Bloodbath", "33": "Timeweave", "34": "Keeneye",
    "61": "Furyedge", "62": "Etherplague", "63": "Colossguard",
    "64": "Swiftraid", "65": "Swiftsmite", "66": "Evolguard"
  },
  "inferno_matrices": [61, 62, 63, 64, 65, 66],
  "slots": {
    "left_1_3": "fixed flat main: slot1=ATK, slot2=HP, slot3=DEF (ring)",

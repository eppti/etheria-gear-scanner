  },
  "stat_markers": {
    "64":  {"stat": "HP",        "scale": 100,  "main_cap": 3300, "flat": true},
    "128": {"stat": "ATK",       "scale": 100,  "main_cap": 330,  "flat": true},
    "192": {"stat": "DEF",       "scale": 100,  "main_cap": 250,  "flat": true},
    "256": {"stat": "SPD",       "scale": 100,  "main_cap": null, "note": "never a main stat"},
    "48":  {"stat": "HP%",       "scale": 10,   "main_cap": 50},
    "112": {"stat": "ATK%",      "scale": 10,   "main_cap": 50},
    "176": {"stat": "DEF%",      "scale": 10,   "main_cap": 50},
    "304": {"stat": "CRIT Rate", "scale": 10,   "main_cap": 40},
    "352": {"stat": "CRIT DMG",  "scale": 10,   "main_cap": 60},
    "400": {"stat": "Eff ACC",   "scale": 10,   "main_cap": 60},
    "448": {"stat": "Eff RES",   "scale": 10,   "main_cap": 60}
  },
  "f5": {
    "matrix_id":    "f5 & 0xFFFF",
    "matrix_slots": "(f5 >> 16) & 0xFFFF   (2 or 3)"
  },

      "high": "varint // 4096   (scaled value)",
      "marker": "varint % 4096   (stat type + roll count)",
      "base": "nearest base marker <= marker (within +0..6)",
      "rolls": "marker - base   (0-4; 4 = maxed/yellow)",
      "value": "high / scale   (scale per stat below)"
